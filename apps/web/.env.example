# Copie para apps/web/.env.local e preencha.

# --- MongoDB Atlas ---
# Connection string do cluster (Database > Connect > Drivers).
MONGODB_URI="mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="pdi_mais"

# --- Auth.js ---
# Gere um segredo: npx auth secret   (ou: openssl rand -base64 33)
AUTH_SECRET=""
# Em produção o Auth.js detecta a URL sozinho; local pode deixar explícito.
AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials -> Criar credencial -> ID do cliente OAuth
# Tipo: Aplicativo da Web
# Origens JavaScript autorizadas:  http://localhost:3000
# URIs de redirecionamento:        http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
